ARG XRAY_VERSION=26.3.27
FROM teddysun/xray:${XRAY_VERSION}

# Restart xray when RioNexGate rewrites config.json (core.Reload).
COPY scripts/xray-run.sh /usr/local/bin/xray-run.sh
RUN chmod +x /usr/local/bin/xray-run.sh

ENTRYPOINT ["/usr/local/bin/xray-run.sh"]
CMD ["run", "-c", "/etc/xray/config.json"]
