{
  "log": {
    "loglevel": "warning"
  },
  "api": {
    "tag": "api",
    "services": ["StatsService"],
    "listen": "{{.APIListenAddress}}"
  },
  "stats": {},
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true
    }
  },
  "inbounds": [
{{- if stealthActive .Stealth}}
{{- if .Stealth.XHTTP.Enabled}}
    {
      "tag": "{{.Stealth.XHTTP.Tag}}",
      "listen": "0.0.0.0",
      "port": {{.Stealth.XHTTP.Port}},
      "protocol": "vless",
      "settings": {
        "clients": [
{{- range $i, $u := .Users}}{{if $i}},{{end}}
          {
            "id": "{{$u.UUID}}",
            "email": "{{$u.Email}}",
            "level": 0
          }
{{- end}}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "show": {{.Stealth.Reality.Show}},
          "dest": "{{.Stealth.Reality.Dest}}",
          "xver": {{.Stealth.Reality.Xver}},
          "serverNames": [{{jsonStrings .Stealth.Reality.ServerNames}}],
          "privateKey": "{{.Stealth.Reality.PrivateKey}}",
          "shortIds": [{{jsonStrings .Stealth.Reality.ShortIDs}}]
        },
        "xhttpSettings": {
          "path": "{{.Stealth.XHTTP.Path}}",
          "mode": "{{.Stealth.XHTTP.Mode}}"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      }
    }{{if or .Stealth.Vision.Enabled .Stealth.TLS.Enabled}},{{end}}
{{- end}}
{{- if .Stealth.Vision.Enabled}}
    {
      "tag": "{{.Stealth.Vision.Tag}}",
      "listen": "0.0.0.0",
      "port": {{.Stealth.Vision.Port}},
      "protocol": "vless",
      "settings": {
        "clients": [
{{- range $i, $u := .Users}}{{if $i}},{{end}}
          {
            "id": "{{$u.UUID}}",
            "email": "{{$u.Email}}",
            "flow": "xtls-rprx-vision",
            "level": 0
          }
{{- end}}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": {{.Stealth.Reality.Show}},
          "dest": "{{.Stealth.Reality.Dest}}",
          "xver": {{.Stealth.Reality.Xver}},
          "serverNames": [{{jsonStrings .Stealth.Reality.ServerNames}}],
          "privateKey": "{{.Stealth.Reality.PrivateKey}}",
          "shortIds": [{{jsonStrings .Stealth.Reality.ShortIDs}}]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      }
    }{{if .Stealth.TLS.Enabled}},{{end}}
{{- end}}
{{- if .Stealth.TLS.Enabled}}
    {
      "tag": "{{.Stealth.TLS.Tag}}",
      "listen": "0.0.0.0",
      "port": {{.Stealth.TLS.Port}},
      "protocol": "vless",
      "settings": {
        "clients": [
{{- range $i, $u := .Users}}{{if $i}},{{end}}
          {
            "id": "{{$u.UUID}}",
            "email": "{{$u.Email}}",
            "level": 0
          }
{{- end}}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "{{.Stealth.TLS.SNI}}",
          "alpn": [{{jsonStrings .Stealth.TLS.ALPN}}]
        }{{if stealthFragmentationTLS .Stealth}},
        "finalmask": {
          "tcp": [{"type": "fragment", "settings": {
            "packets": "{{stealthFragmentPackets .Stealth}}",
            "length": "{{stealthFragmentLength .Stealth}}",
            "delay": "{{stealthFragmentDelay .Stealth}}",
            "maxSplit": "{{stealthFragmentMaxSplit .Stealth}}"
          }}]
        }{{end}}
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      }
    }
{{- end}}
{{- else}}
    {
      "tag": "vless-in",
      "port": {{.ListenPort}},
      "protocol": "vless",
      "settings": {
        "clients": [
{{- range $i, $u := .Users}}{{if $i}},{{end}}
          {
            "id": "{{$u.UUID}}",
            "email": "{{$u.Email}}",
            "level": 0
          }
{{- end}}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp"
      }
    }
{{- end}}
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    }{{- if .Multihop.Enabled}},{{range $i, $ob := .Multihop.Outbounds}}{{if $i}},{{end}}
    {
      "protocol": "{{$ob.Node.Protocol}}",
      "tag": "{{$ob.Tag}}",
      "settings": {
        "vnext": [
          {
            "address": "{{$ob.Node.Address}}",
            "port": {{$ob.Node.Port}},
            "users": [
              {
                "id": "{{$ob.Creds.UUID}}",
                "encryption": "{{$ob.Creds.EncryptionOrDefault}}"{{if $ob.Creds.Flow}},
                "flow": "{{$ob.Creds.Flow}}"{{end}}
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "{{$ob.Creds.NetworkOrDefault}}",
        "security": "{{$ob.Creds.SecurityOrDefault}}"{{if eq $ob.Creds.SecurityOrDefault "reality"}},
        "realitySettings": {
          "serverName": "{{if $ob.Creds.SNI}}{{$ob.Creds.SNI}}{{else}}{{$ob.Node.Address}}{{end}}",
          "fingerprint": "{{$ob.Creds.FingerprintOrDefault}}",
          "publicKey": "{{$ob.Creds.PublicKey}}",
          "shortId": "{{$ob.Creds.ShortID}}"
        }{{end}}{{if eq $ob.Creds.NetworkOrDefault "xhttp"}},
        "xhttpSettings": {
          "path": "{{$ob.Creds.Path}}",
          "mode": "{{$ob.Creds.Mode}}"
        }{{end}}
      }
    },
    {
      "protocol": "freedom",
      "tag": "{{$ob.Tag}}-chain",
      "settings": {
        "domainStrategy": "AsIs"
      },
      "proxySettings": {
        "tag": "{{$ob.Tag}}"
      }
    }{{end}}{{end}}
  ]{{- if .Multihop.Enabled}},
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
{{- range $i, $rule := .Multihop.Routings}}{{if $i}},{{end}}
      {
        "type": "field",
        "user": [{{range $j, $email := $rule.UserEmails}}{{if $j}}, {{end}}"{{$email}}"{{end}}],
        "outboundTag": "{{$rule.OutboundTag}}-chain"
      }
{{- end}}
    ]
  }{{- end}}
}
